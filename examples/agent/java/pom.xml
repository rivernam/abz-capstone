<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>abz.examples</groupId>
  <artifactId>agent-loop</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Jackson 3 계열의 버전을 한 곳에서 맞춘다.
       Claude·OpenAI SDK는 내부에서 Jackson 2를 쓰고, 두 계열은 jackson-annotations를 함께 쓴다.
       이 BOM이 없으면 Maven이 Jackson 2 쪽의 낮은 jackson-annotations를 골라
       Jackson 3이 실행 중에 클래스를 찾지 못한다 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>3.3.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>3.3.0</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>4.114.0</version>
    </dependency>
    <!-- MCP 샘플(McpOrderServer, McpTools)에만 필요하다 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>2.2.0</version>
    </dependency>
    <!-- MCP SDK의 기록(SLF4J)을 끈다. MCP 서버는 표준 출력을 프로토콜에만 써야 한다 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.20</version>
    </dependency>
    <!-- 샘플 코드가 직접 쓰는 JSON 라이브러리(Jackson 3). 버전은 위의 jackson-bom이 정한다 -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
